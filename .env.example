# Copiar este archivo como .env para personalizar la configuracion local.
# Estos valores son de desarrollo y no deben usarse como credenciales reales.

SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

MYSQL_DATABASE=control_academico_db
MYSQL_USER=django_user
MYSQL_PASSWORD=django_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3307

DB_NAME=control_academico_db
DB_USER=django_user
DB_PASSWORD=django_password
DB_HOST=127.0.0.1
DB_PORT=3307
